# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/
tmp/
scripts/sim/.venv/
scripts/sim/out/


# tool/agent meta (per-developer config)
.claude/
.codex/
.agent/
node_modules/
dist/
build/
.next/
.expo/
.understand-anything/

# codex-worker volatile state
.ai/runs/
.ai/state/
.ai/locks/
.ai/control/
.dev-team/wt/
.dev-team/missions/*/runs/
.dev-team/missions/*/state/
