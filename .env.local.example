# === Supabase ===
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용 (API route service-role 클라이언트 — 절대 NEXT_PUBLIC_ 금지)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# OAuth callback redirect 기준 URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 키오스크 QR 목적지 베이스 (kindy.kr DNS 미연결 시 임시 도메인으로 덮어쓰기, 옵션)
NEXT_PUBLIC_KINDY_START_BASE=

# === Claude (감독 에이전트: 시나리오/대본/씬분할/연출/일관성 관리) ===
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# === fal.ai (영상 생성: Seedance 2.0 reference-to-video) ===
FAL_KEY=
SEEDANCE_TIER=standard
# standard = $0.3024/s (720p), fast = $0.2419/s

# === Google Gemini (TTS 어린이 음성 + 나노바나나프로 이미지) ===
GOOGLE_API_KEY=
# Gemini TTS (Google Cloud / Generative Language API)
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_LOCATION=us-central1

# === Inngest ===
# Inngest Cloud webhook 서명 검증용 signing key입니다.
INNGEST_SIGNING_KEY=
# Inngest Cloud 이벤트 발송용 event key입니다.
INNGEST_EVENT_KEY=
# 로컬 개발 시 1, 프로덕션 빈 값
INNGEST_DEV=1

# === Email (결제/갱신 안내) ===
# 미설정 시 결제 이메일은 console.warn 후 no-op. 결제 흐름은 막지 않는다.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kindy <support@kindy.kr>

# === TossPayments v2 빌링(정기결제) ===
# TEST 모드: 토스 문서 공개 샘플 키 사용 가능 (실청구 없음)
#   client: test_ck_docs_Ovk5rk1EwkEbP0W43n07xlzm
#   secret: test_sk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# 실서비스 전환 시 토스 개발자센터에서 발급한 live_* 키로 교체.
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_docs_Ovk5rk1EwkEbP0W43n07xlzm

# 포트원 V2 (가맹 계약사 — 신규 결제는 포트원 경로 사용)
# 콘솔 admin.portone.io → 결제 연동 → 채널 관리(채널 키) / 상점 설정(스토어 ID) / API Keys(V2 Secret)
NEXT_PUBLIC_PORTONE_STORE_ID=store-xxxxxxxx
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx
PORTONE_API_SECRET=
# 콘솔 웹훅 등록(URL: /api/payments/webhook/portone) 시 발급되는 시크릿 — 미설정이면 웹훅 503(fail-closed)
PORTONE_WEBHOOK_SECRET=
TOSS_CLIENT_KEY=test_ck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_sk_docs_OaPz8L5KdmQXkzRz3y47BMw6
# 빌링키 앱레벨 암호화 키 (AES-256-GCM). base64 또는 hex 32바이트 권장.
#   생성 예: openssl rand -base64 32
# 미설정 시: 로컬/테스트는 평문(plain:) 저장, 프로덕션(live 키)은 저장 시 throw.
# 실서비스(live_* 키) 전환 전 반드시 설정.
BILLING_KEY_SECRET=

# === 운영자(콘시어지) ===
# 비스포크 영상 생성 트리거(/api/videos/bespoke) 게이트 키. 대표만 보유.
# 미설정 시 엔드포인트는 503(기능 닫힘) — fal.ai 비용 폭발 방지.
#   생성 예: openssl rand -hex 24
KINDY_OPERATOR_KEY=
# 프로덕션에서 Supabase env 없이 로컬 프리뷰 폴백을 강제 허용(=1). 평소 비움.
KINDY_LOCAL_PREVIEW=

# 사업자 정보 (한국 전자상거래법 표시 의무)
NEXT_PUBLIC_BIZ_REPRESENTATIVE_NAME=
NEXT_PUBLIC_BIZ_REGISTRATION_NUMBER=
NEXT_PUBLIC_BIZ_MAIL_ORDER_NUMBER=
NEXT_PUBLIC_BIZ_ADDRESS=
NEXT_PUBLIC_BIZ_PHONE=
NEXT_PUBLIC_BIZ_EMAIL=support@kindy.kr
